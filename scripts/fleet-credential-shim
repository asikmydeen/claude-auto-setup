#!/usr/bin/env bash
# Fleet Credential Shim — intercepts "claude" CLI calls and rotates Bedrock credentials.
#
# Placed in PATH before the real claude binary. When GSD (or any tool) spawns
# "claude -p ...", this shim:
#   1. Atomically selects the next account from fleet/accounts.json (round-robin)
#   2. Exports that account's credentials as env vars
#   3. Execs the real claude binary with the rotated credentials
#
# Concurrency-safe: uses flock for atomic counter increment.
# Supports N accounts — wraps around when counter exceeds account count.

set -euo pipefail

# --- Config ---
ACCOUNTS_FILE="${FLEET_ACCOUNTS_FILE:-$HOME/.claude/fleet/accounts.json}"
COUNTER_FILE="${FLEET_COUNTER_FILE:-/tmp/fleet-rotation-counter}"
LOCK_FILE="${FLEET_LOCK_FILE:-/tmp/fleet-rotation.lock}"
REAL_CLAUDE="${FLEET_REAL_CLAUDE:-}"

# --- Find real claude (skip ourselves) ---
if [ -z "$REAL_CLAUDE" ]; then
  # Walk PATH, skip entries containing "fleet-shim" to find the real claude
  IFS=':' read -ra path_entries <<< "$PATH"
  for dir in "${path_entries[@]}"; do
    case "$dir" in
      *fleet-shim*) continue ;;  # Skip our shim directory
    esac
    if [ -x "$dir/claude" ] && [ "$dir/claude" != "$0" ]; then
      REAL_CLAUDE="$dir/claude"
      break
    fi
  done
fi

if [ -z "$REAL_CLAUDE" ] || [ ! -x "$REAL_CLAUDE" ]; then
  echo "fleet-credential-shim: ERROR — cannot find real claude binary" >&2
  echo "Set FLEET_REAL_CLAUDE=/path/to/claude or ensure claude is in PATH" >&2
  exit 1
fi

# --- Check if fleet accounts exist ---
if [ ! -f "$ACCOUNTS_FILE" ]; then
  # No fleet config — pass through to real claude without rotation
  exec "$REAL_CLAUDE" "$@"
fi

# --- Atomic round-robin account selection ---
# Uses mkdir as a POSIX-portable lock (atomic on all systems, no flock needed).
# Each process: acquire lock → read counter → increment → release lock.
touch "$COUNTER_FILE" 2>/dev/null || true

acquire_lock() {
  local attempts=0
  while ! mkdir "$LOCK_FILE" 2>/dev/null; do
    attempts=$((attempts + 1))
    if [ "$attempts" -gt 50 ]; then
      # Stale lock — force break after 5 seconds
      rm -rf "$LOCK_FILE"
    fi
    sleep 0.1
  done
}

release_lock() {
  rm -rf "$LOCK_FILE"
}

acquire_lock
current=$(cat "$COUNTER_FILE" 2>/dev/null || echo "0")
current=$((current + 0))
selected_index=$current
echo $(( current + 1 )) > "$COUNTER_FILE"
release_lock

# --- Extract and export credentials for selected account ---
eval "$(python3 -c "
import json, sys, os

try:
    with open('$ACCOUNTS_FILE') as f:
        config = json.load(f)
except Exception as e:
    print(f'echo \"fleet-shim: failed to read accounts: {e}\" >&2', file=sys.stdout)
    sys.exit(0)

accounts = config.get('accounts', [])
if not accounts:
    sys.exit(0)

idx = $selected_index % len(accounts)
account = accounts[idx]
creds = account.get('credentials', {})

# Export each credential as an env var
for key, value in creds.items():
    # Shell-escape the value
    escaped = value.replace(\"'\", \"'\\\"'\\\"'\")
    print(f\"export {key}='{escaped}'\")

# Log which account was selected (to stderr, won't pollute claude output)
label = account.get('label', account.get('id', f'account-{idx}'))
print(f'echo \"[fleet-shim] Using account: {label} (index {idx}/{len(accounts)})\" >&2')
" 2>/dev/null)"

# --- Ensure nested session support ---
export CLAUDECODE=""
export CLAUDE_CODE_ENTRYPOINT=""

# --- Fix Bedrock model ID compatibility ---
# GSD passes --model claude-sonnet-4-6 but Bedrock needs us.anthropic.* prefix.
# Strip --model flag when running under Bedrock — let Claude Code use its default.
ARGS=("$@")
if [ "${CLAUDE_CODE_USE_BEDROCK:-}" = "1" ]; then
  FIXED_ARGS=()
  skip_next=false
  for arg in "${ARGS[@]}"; do
    if $skip_next; then skip_next=false; continue; fi
    if [ "$arg" = "--model" ]; then skip_next=true; continue; fi
    # Handle --model=value format
    case "$arg" in --model=*) continue ;; esac
    FIXED_ARGS+=("$arg")
  done
  ARGS=("${FIXED_ARGS[@]}")
fi

# --- Exec the real claude with rotated credentials ---
exec "$REAL_CLAUDE" "${ARGS[@]}"
