{
  "_comment": "Provider registry — maps task types to preferred AI agents with fallback chains",
  "_usage": "The orchestrator reads this to decide which agent handles each task",

  "providers": {
    "claude": {
      "cli": "claude",
      "non_interactive": "claude -p \"{prompt}\" --output-format text --allowedTools \"{tools}\"",
      "strengths": ["complex-reasoning", "planning", "architecture", "multi-file-refactor", "debugging", "code-review"],
      "context_window": "200k",
      "cost": "high",
      "speed": "medium"
    },
    "codex": {
      "cli": "codex",
      "non_interactive": "codex -q \"{prompt}\" --full-auto",
      "strengths": ["fast-code-generation", "test-writing", "simple-implementations", "boilerplate"],
      "context_window": "192k",
      "cost": "medium",
      "speed": "fast"
    },
    "gemini": {
      "cli": "gemini",
      "non_interactive": "gemini -p \"{prompt}\"",
      "strengths": ["documentation", "frontend-generation", "large-context-analysis", "search-grounded"],
      "context_window": "1000k",
      "cost": "low",
      "speed": "fast"
    },
    "amp": {
      "cli": "amp",
      "non_interactive": "amp \"{prompt}\"",
      "strengths": ["code-review", "oracle-guidance", "multi-model-routing"],
      "context_window": "200k",
      "cost": "medium",
      "speed": "medium"
    },
    "kiro": {
      "cli": "kiro-cli",
      "non_interactive": "kiro-cli chat --no-interactive --trust-tools=\"@builder-mcp/ReadRemoteTestRun,@builder-mcp/InternalCodeSearch,@builder-mcp/ReadInternalWebsites\" \"{prompt}\"",
      "mcp_tools": ["@builder-mcp/ReadRemoteTestRun", "@builder-mcp/InternalCodeSearch", "@builder-mcp/ReadInternalWebsites"],
      "strengths": ["aws-integration", "spec-driven-development", "internal-code-search", "test-run-analysis"],
      "context_window": "200k",
      "cost": "medium",
      "speed": "medium"
    },
    "copilot": {
      "cli": "copilot",
      "non_interactive": "copilot -p \"{prompt}\" --allow-tool='shell' --allow-tool='write'",
      "strengths": ["github-workflows", "pr-management", "issue-triage", "git-operations", "ci-cd", "code-modification"],
      "context_window": "200k",
      "cost": "subscription",
      "speed": "medium"
    },
    "oma": {
      "cli": "oma",
      "non_interactive": "oma run \"{prompt}\"",
      "team_mode": "oma team \"{prompt}\"",
      "mcp_mode": "oma run \"{prompt}\" --tools ship,memory",
      "strengths": ["multi-agent-orchestration", "mcp-integration", "infrastructure-ops", "memory-ops", "team-collaboration", "parallel-tasks"],
      "context_window": "200k",
      "cost": "zero",
      "speed": "medium",
      "note": "Uses Bedrock via LiteLLM proxy (port 4000). Requires proxy running."
    }
  },

  "task_routing": {
    "_comment": "Maps task types to ordered provider preferences. First available provider is used.",

    "planning": ["claude", "gemini", "amp"],
    "architecture-design": ["claude", "amp", "gemini"],
    "complex-reasoning": ["claude", "amp"],
    "debugging": ["claude", "codex", "amp"],
    "code-review-quality": ["amp", "claude"],
    "code-review-security": ["claude", "amp"],
    "code-review-performance": ["claude", "amp", "gemini"],

    "backend-implementation": ["claude", "codex", "amp"],
    "frontend-implementation": ["codex", "claude", "gemini"],
    "api-implementation": ["claude", "codex"],
    "multi-agent": ["oma", "claude"],
    "infrastructure-ops": ["oma", "claude"],
    "memory-ops": ["oma", "claude"],
    "test-writing": ["codex", "claude", "gemini"],
    "boilerplate-generation": ["codex", "gemini", "claude"],

    "documentation": ["gemini", "claude", "amp"],
    "large-file-analysis": ["gemini", "claude"],
    "dependency-analysis": ["gemini", "claude", "codex"],

    "infrastructure-aws": ["kiro", "claude"],
    "cdk-cloudformation": ["kiro", "claude"],
    "amazon-internal": ["kiro", "claude"],
    "brazil-build": ["kiro", "claude"],
    "aws-debugging": ["kiro", "claude"],
    "aws-sdk": ["kiro", "claude"],
    "aws-lambda": ["kiro", "claude"],
    "aws-dynamodb": ["kiro", "claude"],
    "aws-s3": ["kiro", "claude"],
    "aws-api-gateway": ["kiro", "claude"],
    "aws-sqs-sns": ["kiro", "claude"],
    "aws-iam": ["kiro", "claude"],
    "internal-code-search": ["kiro", "claude"],
    "integration-test": ["kiro", "claude"],
    "internal-docs": ["kiro", "claude"],
    "cr-review": ["kiro", "claude"],
    "pipeline-debug": ["kiro", "claude"],

    "simple-edit": ["codex", "copilot", "claude", "gemini"],
    "refactoring": ["claude", "codex", "copilot", "amp"],
    "migration": ["claude", "amp", "codex"],

    "github-pr": ["copilot", "claude", "amp"],
    "github-issues": ["copilot", "claude"],
    "git-operations": ["copilot", "codex", "claude"],
    "ci-cd": ["copilot", "claude", "kiro"]
  },

  "cost_optimization": {
    "_comment": "When multiple providers can do the job, prefer cheaper/faster ones for simple tasks",
    "simple_threshold": 3,
    "simple_providers": ["codex", "gemini"],
    "complex_providers": ["claude", "amp"],
    "review_providers": ["amp", "claude"]
  }
}
