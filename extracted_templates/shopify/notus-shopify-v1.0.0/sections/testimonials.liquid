<div class="wrapper">
    {% if section.settings.heading != blank %}
      <div class="section-header text-center">
        <h3 class="font-weight-bold mb-2 section-header__title">{{ section.settings.heading | escape }}</h3>
        {% if section.settings.subheading != blank %}
         <p>{{ section.settings.subheading | escape }}</p>
      	{% endif %}
      </div>
    {% endif %}
  
    <div class="grid collection-grid">
        {% comment %}
          Show up to 9 testimonials.
        {% endcomment %}
      
        {% assign isEmpty = true %}
        {% assign testimonial_index = 0 %}
        {% assign testimonial_count = 0 %}
        {% assign testimonial_limit = section.blocks.size %}
      
        {% comment %}
          Add one to the testimonial limit to offset chance of Frontpage being included
        {% endcomment %}
        {% assign testimonial_limit = testimonial_limit | plus: 1 %}

        {% comment %}
          Calculate number of testimonials to show, making sure Frontpage isn't one
        {% endcomment %}
        {% for testimonial in section.blocks limit: testimonial_limit %}
            {% assign testimonial_count = testimonial_count | plus: 1 %}
        {% endfor %}

        {% if testimonial_count > 0 %}
          {% assign isEmpty = false %}
        {% endif %}

        {% assign divisible_by_three = testimonial_count | modulo: 3 %}
        {% assign divisible_by_two = testimonial_count | modulo: 2 %}
      
        {% comment %}
          Loop through the testimonials to display
        {% endcomment %}
        {% for block in section.blocks limit: testimonial_limit %}
      		
      	{% assign testimonial_index = testimonial_index | plus: 1 %}
      		
      	  {% if testimonial_count == 1 %}
          <div class="grid__item one-whole min-height-250 text-center mb-5">
          {% elsif testimonial_count == 2 or testimonial_count == 4 or testimonial_count == 8 %}
          <div class="grid__item one-whole min-height-250 medium--one-half large--one-half text-center mb-5">
          {% elsif testimonial_count == 5 %}
            {% if testimonial_index == 4 or testimonial_index == 5 %}
          		<div class="grid__item one-whole min-height-250 medium--one-half large--one-half text-center mb-5">
            {% else %}
                <div class="grid__item one-whole min-height-250 medium--one-third large--one-third text-center mb-5">
            {% endif %}
          {% elsif testimonial_count == 7 %}
            {% if testimonial_index == 7 %}
          		<div class="grid__item one-whole min-height-250 text-center mb-5">
            {% else %}
                <div class="grid__item one-whole min-height-250 medium--one-third large--one-third text-center mb-5">
            {% endif %}
          {% else %}
          <div class="grid__item one-whole min-height-250 medium--one-third large--one-third text-center mb-5">
          {% endif %}
            {% if block.settings.show_image %}
             {% if block.settings.image != blank %}
              <noscript>
                {{ block.settings.image | img_url: '600x600' | img_tag: block.settings.image.alt, 'feature-row__image-no-js' }}
              </noscript>
              <div class="feature-row__image-wrapper">
                {% assign img_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                <img class="lazyload avatar shadow rounded-circle mb-2"
                  src="{{ block.settings.image | img_url: '100x100' }}"
                  data-src="{{ img_url }}"
                  data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                  data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                  data-sizes="auto"
                  alt="{{ block.settings.image.alt | escape }}">
              </div>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' | replace: 'placeholder-svg', 'placeholder-svg avatar shadow rounded-circle mb-2' }}
            {% endif %}
           {% endif %}
            
           {% if block.settings.quote != blank %}
            	{% if block.settings.show_image %}
      				<div class="rte-setting">{{ block.settings.quote }}</div>
            	{% else %}
            		<div class="rte-setting mt-6">{{ block.settings.quote }}</div>
            	{% endif %}
           {% endif %}
            
           {% if block.settings.author != blank %}
            <div class="text-sm font-weight-bold">{{ block.settings.author }}</div>
           {% endif %}
          </div>
        {% endfor %}
   
    </div>
</div>

