<div class="wrapper">
    <div class="grid collection-grid">
        {% comment %}
          Show up to 6 features.
        {% endcomment %}
      
        {% assign isEmpty = true %}
        {% assign feature_index = 0 %}
        {% assign feature_count = 0 %}
        {% assign feature_limit = section.blocks.size %}
      
        {% comment %}
          Add one to the feature limit to offset chance of Frontpage being included
        {% endcomment %}
        {% assign feature_limit = feature_limit | plus: 1 %}

        {% comment %}
          Calculate number of features to show, making sure Frontpage isn't one
        {% endcomment %}
        {% for feature in section.blocks limit: feature_limit %}
            {% assign feature_count = feature_count | plus: 1 %}
        {% endfor %}

        {% if feature_count > 0 %}
          {% assign isEmpty = false %}
        {% endif %}

        {% assign divisible_by_three = feature_count | modulo: 3 %}
        {% assign divisible_by_two = feature_count | modulo: 2 %}
      
        {% comment %}
          Loop through the features to display
        {% endcomment %}
        {% for block in section.blocks limit: feature_limit %}
      		
      	  {% if feature_count == 1 %}
          <div class="grid__item one-whole text-center mb-5">
          {% elsif feature_count == 2 %}
          <div class="grid__item one-whole medium--one-half large--one-half text-center mb-5">
          {% elsif feature_count == 5 %}
          <div class="grid__item one-whole medium--one-fifth large--one-fifth text-center mb-5">
          {% elsif feature_count == 3 or feature_count == 6 %}
          <div class="grid__item one-whole medium--one-third large--one-third text-center mb-5">
          {% else %}
          <div class="grid__item one-whole medium--one-quarter large--one-quarter text-center mb-5">
          {% endif %}
           {% if block.settings.image != blank %}
            <noscript>
              {{ block.settings.image | img_url: '600x600' | img_tag: block.settings.image.alt, 'feature-row__image-no-js' }}
            </noscript>
            <div class="feature-row__image-wrapper width-30 height-30 mx-auto mb-2 background-contain background-center background-repeat-none" style="background-image:url('{{ block.settings.image | img_url: '300x300' }}')">
              
            </div>
          {% else %}
            <div class="feature-row__image-wrapper width-30 height-30 mx-auto mb-2 background-contain background-center background-repeat-none" style="background-image:url('{{ "delivery.png" | asset_url }}')">
              
            </div>
          
          {% endif %}
            
           {% if block.settings.heading != blank %}
            <div class="text-lg font-weight-bold mb-2">{{ block.settings.heading }}</div>
           {% endif %}
            
           {% if block.settings.subheading != blank %}
      			<div class="rte-setting text-sm">{{ block.settings.subheading }}</div>
           {% endif %}
            
          </div>
        {% endfor %}
   
    </div>
</div>

