<div class="wrapper">
    {% if section.settings.heading != blank %}
      <div class="section-header text-center">
        <h3 class="font-weight-bold mb-0 section-header__title mb-2">{{ section.settings.heading | escape }}</h3>
        {% if section.settings.description != blank %}
        <p class="mb-0"> {{ section.settings.description | escape }} </p>
        {% endif %}
      </div>
    {% endif %}
  
    <div class="grid collection-grid">
        {% comment %}
          Show up to 12 accordions.
        {% endcomment %}
      
        {% assign isEmpty = true %}
        {% assign accordion_index = 0 %}
        {% assign accordion_count = 0 %}
        {% assign accordion_limit = section.blocks.size %}
      
        {% comment %}
          Add one to the accordionlimit to offset chance of Frontpage being included
        {% endcomment %}
        {% assign accordion_limit = accordion_limit | plus: 1 %}

        {% comment %}
          Calculate number of accordions to show, making sure Frontpage isn't one
        {% endcomment %}
        {% for accordion in section.blocks limit: accordion_limit %}
            {% assign accordion_count = accordion_count | plus: 1 %}
        {% endfor %}

        {% if accordion_count > 0 %}
          {% assign isEmpty = false %}
        {% endif %}

        {% assign divisible_by_three = accordion_count | modulo: 3 %}
        {% assign divisible_by_two = accordion_count | modulo: 2 %}
      
        {% comment %}
          Loop through the accordions to display
        {% endcomment %}
      	
      <div class="grid__item one-whole text-center mb-3">
      	<div class="accordion-group">
          <div class="accordion">
          {% for block in section.blocks limit: accordion_limit %}

            	<div class="accordion-item">
                 <button class="accordion-header d-flex align-items-center pt-4 pb-2 px-1">
                   {% if block.settings.title != blank %}
                    <p class="mb-0 font-weight-bold">{{ block.settings.title }}</p>
                   {% else %}
                    <p class="mb-0">Test title</p>
                   {% endif %}
                   <i class="arrow fas fa-angle-down text-lg ms-auto"></i>
                </button>

                <div class="accordion-panel pt-0 pb-4 px-1">
                  {% if block.settings.description != blank %}
                   {{ block.settings.description }}
                  {% else %}
                   Test description
                  {% endif %}
                </div>
               </div>

          {% endfor %}

          </div>
        </div>
       </div>
   
    </div>
</div>

