<script>
  
var acc = document.getElementsByClassName("accordion-header");
var i;

for (i = 0; i < acc.length; i++) {
    acc[i].onclick = function(){
      	var el = this;
        this.classList.toggle("active");
       

        this.nextElementSibling.classList.add("collapsing");
      	
      if(!this.nextElementSibling.classList.contains('show')){
          setTimeout(function () {
            el.nextElementSibling.style.height = el.nextElementSibling.children[0].offsetHeight + 'px';
          }, 100);
      }

      setTimeout(function () {
           el.nextElementSibling.classList.remove("collapsing");
           el.nextElementSibling.classList.toggle("show");
           el.nextElementSibling.style.height = '';
        }, 200);
      	
  }
}

</script>
