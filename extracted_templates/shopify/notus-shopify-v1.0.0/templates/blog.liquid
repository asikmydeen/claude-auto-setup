<!-- /templates/blog.liquid -->
{% paginate blog.articles by 5 %}

<div class="grid">

  <div class="grid__item large--four-sixths push--large--two-twelfths">

    <header class="section-header text-center mb-4">
      <span class="text-link text-uppercase">Blog</span>
      <h1>
        {% if current_tags %}
          {{ blog.title | link_to: blog.url }} &mdash; {{ current_tags.first }}
        {% else %}
          {{ blog.title }}
        {% endif %}
      </h1>
    </header>

    {% for article in blog.articles %}

      {% assign article_content = article.excerpt_or_content %}

      <article class="article grid small--text-center shadow border-radius-lg bg-white p-3 mx-2 mb-5">

        {% unless article.image == blank %}
          <div class="grid__item ps-0">
            <a class="article__featured-image-link" href="{{ article.url }}">
              <noscript>
                {{ article.image | img_url: '2048x2048' | img_tag: article.title | escape }}
              </noscript>
              <div class="article__featured-image-wrapper" style="padding-top:{{ 1 | divided_by: article.image.aspect_ratio | times: 100}}%;">
                {% assign img_url = article.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                <img class="article__featured-image lazyload border-radius-md"
                  src="{{ article.image | img_url: '300x300' }}"
                  data-src="{{ img_url }}"
                  data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
                  data-aspectratio="{{ article.image.aspect_ratio }}"
                  data-sizes="auto"
                  alt="{{ article.title | escape }}">
              </div>
            </a>
          </div>
        {% endunless %}

        <div class="grid__item ps-2 mt-3">
          {% if article.tags.size > 0 %}
            <ul class="tags tags--article inline-list">
              {% include 'tags-article' %}
            </ul>
          {% endif %}
        </div>
        <div class="grid__item ps-2">
          <h2 class="lead"><a class="article__heading-link" href="{{ article.url }}">{{ article.title }}</a></h2>
          <div class="rte rte--indented-images">
            {{ article_content | strip_html | truncatewords: 120 }} test
          </div>

          <p>
            <a href="{{ article.url }}" class="text-primary icon-move-right">{{ 'blogs.article.read_more' | t }} <span class="icon icon-arrow-right" aria-hidden="true"></span></a>
          </p>
        </div>
        
        <div class="grid__item d-flex ps-2">
          <span class="text-sm">{{article.author}}</span>
          <div class="d-flex align-items-center ms-auto">
            <span>
         	 <i class="far fa-calendar text-sm me-2"></i>
            </span>
            <span>
          	 <time datetime="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}" class="date text-sm">{{ article.published_at | date: format: 'date' }}</time>
            </span>
          </div>
        </div>
      </article>

    {% endfor %}

    {% if paginate.pages > 1 %}
      {% include 'pagination' %}
    {% endif %}

  </div>
</div>

{% endpaginate %}
