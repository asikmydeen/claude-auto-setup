  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --s",
    "build:fontawesome": "mkdir -p public/assets/vendor/@fortawesome/fontawesome-free/webfonts && mkdir -p public/assets/vendor/@fortawesome/fontawesome-free/css && cp -a ./node_modules/@fortawesome/fontawesome-free/webfonts public/assets/vendor/@fortawesome/fontawesome-free/ && cp ./node_modules/@fortawesome/fontawesome-free/css/all.min.css public/assets/vendor/@fortawesome/fontawesome-free/css/all.min.css",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && rm -rf public/build/bundle.js && rm -rf public/build/bundle.js.map && rm -rf public/bundle.js && rm -rf public/bundle.js.map && npm install && npm run build:fontawesome && npm run build && cp public/build/bundle.js public/bundle.js && cp public/build/bundle.js.map public/bundle.js.map && npm run dev"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "21.0.1",
    "@rollup/plugin-node-resolve": "13.0.6",
    "postcss": "8.4.1",
    "rollup": "2.60.1",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-svelte": "7.1.0",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-css-only": "3.1.0",
    "sass": "1.43.5",
    "svelte": "3.38.3",
    "svelte-preprocess": "4.9.8"
  },
  "dependencies": {
    "@beyonk/svelte-googlemaps": "3.1.0",
    "@fullcalendar/core": "4.4.2",
    "@fullcalendar/daygrid": "4.4.2",
    "@fullcalendar/interaction": "4.4.2",
    "@fullcalendar/timegrid": "4.4.2",
    "bootstrap": "4.3.1",
    "datatables.net": "1.11.3",
    "datatables.net-dt": "1.11.3",
    "date-fns": "2.26.0",
    "fusioncharts": "3.18.0",
    "fusionmaps": "3.18.0",
    "google-maps": "4.2.3",
    "jquery": "3.6.0",
    "page.js": "4.13.3",
    "sirv-cli": "1.0.14",
    "style-loader": "3.3.1",
    "svelte-calendar": "3.1.6",
    "svelte-flatpickr": "3.2.4",
    "svelte-fullcalendar": "0.2.1",
    "svelte-fusioncharts": "1.0.0",
    "svelte-fuzzy": "2.1.0",
    "svelte-google-maps": "0.2.0",
    "svelte-notifications": "0.9.91",
    "svelte-quill": "1.2.0",
    "svelte-router-spa": "6.0.3",
    "svelte-table": "0.3.1",
    "svelte-tags-input": "2.8.1",
    "svelte-tooltip": "1.2.0",
    "sveltefileuploadcomponent": "0.1.0",
    "sweetalert2": "11.2.1",
    "topojson": "3.0.2",
    "sveltejs-forms": "2.1.2",
    "uuidv1": "1.6.14",
    "yup": "0.32.11"
  }
}
