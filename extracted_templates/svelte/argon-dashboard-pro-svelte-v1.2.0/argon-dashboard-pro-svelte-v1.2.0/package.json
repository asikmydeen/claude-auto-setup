  "description": "Svelte version of the Argon Dashboard PRO by Creative Tim",
  "main": "rollup.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creativetimofficial/ct-argon-dashboard-pro-svelte.git"
  },
  "keywords": [],
