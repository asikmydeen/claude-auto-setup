{
  "permissions": {
    "allow": [
      "Bash(brazil-build *)",
      "Bash(bb *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(aws *)",
      "Bash(ada *)",
      "Bash(cdk *)",
      "Bash(sam *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(cargo *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(mise *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(note *)",
      "Bash(clips *)",
      "Bash(micro *)",
      "Bash(codex *)",
      "Bash(gemini *)",
      "Bash(amp *)",
      "Bash($HOME/.claude/scripts/enforce.sh *)",
      "Bash($HOME/.claude/scripts/hook-handler.sh *)",
      "Bash(cmux *)",
      "Bash(kiro-cli *)",
      "Bash(ov *)",
      "Bash(openviking-server *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.aws/credentials)",
      "Read(./.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)"
    ]
  },
  "model": "claude-opus-4-6",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_ID=\"session-$$-$(date +%s)\"; curl -s -X POST http://localhost:3200/api/sessions -H 'Content-Type: application/json' -d \"{\\\"id\\\":\\\"$SESSION_ID\\\",\\\"pid\\\":\\\"$$\\\",\\\"cwd\\\":\\\"$(pwd)\\\",\\\"project\\\":\\\"$(basename $(pwd))\\\"}\" --connect-timeout 1 -o /dev/null 2>/dev/null; echo \"## Session Context\\n- Dashboard session: $SESSION_ID\\n- AWS credentials: run \\`ada credentials update --account=616047499392 --provider=isengard --role=Admin --once\\` if needed\\n- Projects: /workplace/ammydeen/DataCenterProcurementSystems | /workplace/ammydeen/Watermark\\n- Build: brazil-build release | brazil-build run start | brazil-build run test\\n- Providers: \"$(which codex gemini amp 2>/dev/null | tr '\\n' ', ' || echo 'claude only')"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/enforce.sh session-start 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/smart-install.js\" 2>/dev/null || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" start 2>/dev/null || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code context 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/prompt-enhancer.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code session-init 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/pre-edit-guard.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/hook-handler.sh pre-edit 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/hook-handler.sh edit 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/post-commit-review.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/hook-handler.sh bash 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/scripts/post-commit-review.py 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/hook-handler.sh agent 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code observation 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/enforce.sh session-stop 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code summarize 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; [ -d \"$_R\" ] && node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code session-complete 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "superpowers@claude-plugins-official": true,
    "ui-ux-pro-max@nextlevelbuilder": true
  },
  "showTurnDuration": true,
  "skipDangerousModePermissionPrompt": true
}
