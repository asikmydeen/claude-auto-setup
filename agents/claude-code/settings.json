{
  "permissions": {
    "allow": [
      "Bash(brazil-build *)",
      "Bash(bb *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(aws *)",
      "Bash(ada *)",
      "Bash(cdk *)",
      "Bash(sam *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(cargo *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(mise *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(note *)",
      "Bash(clips *)",
      "Bash(micro *)",
      "Bash(codex *)",
      "Bash(gemini *)",
      "Bash(amp *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.aws/credentials)",
      "Read(./.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)"
    ]
  },
  "model": "claude-opus-4-6",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '## Session Context\\n- AWS credentials: run `ada credentials update --account=616047499392 --provider=isengard --role=Admin --once` if needed\\n- Projects: /workplace/ammydeen/DataCenterProcurementSystems | /workplace/ammydeen/Watermark\\n- Build: brazil-build release | brazil-build run start | brazil-build run test\\n- Providers: '$(which codex gemini amp 2>/dev/null | tr '\\n' ', ' || echo 'claude only')"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$TOOL_INPUT_file_path\"; EXT=\"${FILE##*.}\"; if [ \"$EXT\" = \"ts\" ] || [ \"$EXT\" = \"tsx\" ] || [ \"$EXT\" = \"js\" ] || [ \"$EXT\" = \"jsx\" ]; then cd \"$(dirname \"$FILE\")\" && npx eslint --no-error-on-unmatched-pattern --max-warnings=50 --format compact \"$FILE\" 2>/dev/null | head -20 || true; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "showTurnDuration": true,
  "skipDangerousModePermissionPrompt": true
}
